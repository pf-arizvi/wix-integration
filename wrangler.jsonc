{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wix-integration",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Public URL: https://wix-integration.pf-integrations.workers.dev
  // Mintsoft webhook URLs are built from it — don't change the subdomain.
  "workers_dev": true,
  // Per-version preview URLs would run with production D1 + secrets. Keep off.
  "preview_urls": false,

  // Workers Logs (free plan includes it). Lets us check CPU time per invocation.
  "observability": { "enabled": true },

  // Free plan: max 5 cron triggers per account. We use 2.
  // Must match CRON in src/config.ts.
  "triggers": {
    "crons": [
      "*/5 * * * *", // F1 importOrders
      "2-59/5 * * * *" // F3 reconcile (+ webhook_log purge), 2 min after each import
    ]
  },

  // Non-secret config. Strings on purpose: parsed in src/config.ts.
  // Secrets (MINTSOFT_API_KEY, ADMIN_TOKEN, ENCRYPTION_KEY) are set with
  // `wrangler secret put` and, locally, in .dev.vars. See .dev.vars.example.
  "vars": {
    "MAX_ORDERS_PER_RUN": "15",
    "DEBUG_PAYLOADS": "false",
    // Public base URL of the deployed Worker, used to build Mintsoft webhook URLs.
    "WORKER_BASE_URL": "https://wix-integration.pf-integrations.workers.dev",

    // ── Mintsoft write guardrails (enforced in src/adapters/mintsoft/client.ts) ──
    // Deploy-level MASTER. Writes happen only when this is exactly "true" AND the admin page's
    // writes toggle (D1 settings, off until someone switches it on) is on. "false" locks writes
    // off whatever the page says. Allowlist below always applies.
    "MINTSOFT_WRITES_ENABLED": "true",
    // Comma-separated Mintsoft ClientIds that may be written to. Any write for
    // another ClientId is refused before it leaves the Worker. 38 = Wix Test Client.
    "MINTSOFT_ALLOWED_CLIENT_IDS": "38",
    // Mintsoft WarehouseId sent on every order (required by PUT /api/Order). Same for all clients.
    "MINTSOFT_WAREHOUSE_ID": "3",

    // Cloudflare Access (admin page sign-in). Empty = Access login off; only the admin token works.
    // Team domain e.g. "premiumfulfilment.cloudflareaccess.com"; AUD = the Access application's AUD tag.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wix-integration",
      "database_id": "3611a285-94a3-4492-b560-46fb0e3dc059",
      "migrations_dir": "migrations"
    }
  ]
}
