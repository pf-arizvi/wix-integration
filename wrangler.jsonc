{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wix-integration",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Public URL: https://wix-integration.pf-integrations.workers.dev
  // Mintsoft webhook URLs are built from it — don't change the subdomain.
  "workers_dev": true,
  // Per-version preview URLs would run with production D1 + secrets. Keep off.
  "preview_urls": false,

  // Workers Logs (free plan includes it). Lets us check CPU time per invocation.
  "observability": { "enabled": true },

  // Free plan: max 5 cron triggers per account. We use 2.
  // Must match CRON in src/config.ts.
  "triggers": {
    "crons": [
      "*/5 * * * *", // F1 importOrders
      "0 * * * *"    // F3 reconcile
    ]
  },

  // Non-secret config. Strings on purpose: parsed in src/config.ts.
  // Secrets (MINTSOFT_API_KEY, ADMIN_TOKEN, ENCRYPTION_KEY) are set with
  // `wrangler secret put` and, locally, in .dev.vars. See .dev.vars.example.
  "vars": {
    "MAX_ORDERS_PER_RUN": "15",
    "DEBUG_PAYLOADS": "false",
    // Public base URL of the deployed Worker, used to build Mintsoft webhook URLs.
    "WORKER_BASE_URL": "https://wix-integration.pf-integrations.workers.dev"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wix-integration",
      "database_id": "3611a285-94a3-4492-b560-46fb0e3dc059",
      "migrations_dir": "migrations"
    }
  ]
}
